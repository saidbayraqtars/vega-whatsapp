{
  "name": "vega-whatsapp-desktop",
  "version": "1.1.10",
  "description": "Vega WhatsApp — masaüstü (Electron). Toplu mesaj + otomatik tahsilat takibi.",
  "main": "electron/main.js",
  "author": "Vega",
  "repository": {
    "type": "git",
    "url": "https://github.com/saidbayraqtars/vega-whatsapp.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.vega.whatsapp",
    "productName": "Vega WhatsApp",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saidbayraqtars",
        "repo": "vega-whatsapp-releases",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**",
      "server/**",
      "!server/build/**",
      "!server/data/**",
      "!server/node_modules/**",
      "!server/config.json",
      "!server/server.log",
      "!server/_x/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vega WhatsApp"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  }
}
